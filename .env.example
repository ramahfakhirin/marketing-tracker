# GEMINI_API_KEY: Optional - Required if using Gemini AI API features
GEMINI_API_KEY=""

# APP_URL: Domain URL for the deployment
APP_URL="https://crm.yourdomain.com"

# PORT: Server port (default: 3000)
PORT=3000

# DATABASE_URL: PostgreSQL connection string (Optional - fallback to Firestore or local memory if empty)
# Format: postgres://username:password@host:5432/databasename
DATABASE_URL=""


